# ===== Application =====
NODE_ENV=development
APP_PORT=4000
WEB_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# ===== PostgreSQL (pgvector) =====
POSTGRES_USER=film
POSTGRES_PASSWORD=change_me
POSTGRES_DB=film_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://film:change_me@localhost:5432/film_platform?schema=public

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ===== MinIO (S3-compatible Object Storage) =====
MINIO_ENDPOINT=localhost
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_too
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_MEDIA=film-media
MINIO_BUCKET_RESTORED=film-restored

# ===== Auth & OAuth 2.0 (Phase 2) =====
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== Thanh toán Sandbox (Phase 4) =====
VNPAY_TMN_CODE=DEMO_TMN
VNPAY_HASH_SECRET=DEMO_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/bookings/payment-return

# ===== AI Service (Phase 8) =====
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_API_KEY=your_llm_api_key_optional
