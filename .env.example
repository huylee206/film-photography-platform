# ==============================================================================
# FILM PHOTOGRAPHY PLATFORM - MICROSERVICES & SOA ENVIRONMENT CONFIGURATION
# ==============================================================================
NODE_ENV=development

# --- API Gateway (Nginx) ---
GATEWAY_PORT=4000

# --- PostgreSQL 16 (Database-per-Service Logical Isolation) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=film_admin
POSTGRES_PASSWORD=film_secret_2026
POSTGRES_DB=film_platform
DATABASE_URL=postgresql://film_admin:film_secret_2026@postgres:5432/film_platform

# --- Redis (Cache & Event Bus / Pub-Sub) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Microservice 1: Identity Service (Port 4001) ---
IDENTITY_SERVICE_PORT=4001
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_2026
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_KEY=internal_soa_shared_secret_2026
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- Microservice 2: Catalog & Booking Service (Port 4002) ---
CATALOG_BOOKING_SERVICE_PORT=4002
IDENTITY_SERVICE_URL=http://identity-service:4001
VNPAY_TMN_CODE=DEMO_TMN
VNPAY_HASH_SECRET=DEMO_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/v1/payments/vnpay-return

# --- Microservice 3: Community & Analytics Service (Port 4003) ---
COMMUNITY_SERVICE_PORT=4003

# --- Microservice 4: AI Service (FastAPI - Port 8000) ---
AI_SERVICE_PORT=8000
OPENAI_API_KEY=your_openai_or_gemini_api_key
EMBEDDING_MODEL=text-embedding-3-small

# --- Frontend Web (Vite - Port 5173) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
